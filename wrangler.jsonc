// Cloudflare Workers config for the OpenNext build (`npm run cf:build`).
// Runbook: docs/deploy/cloudflare.md
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sv-uvm-guide",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-12-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // Plain runtime variables. Secrets (NEXTAUTH_SECRET, later DATABASE_URL and
  // OAuth keys) are set with `wrangler secret put` and survive every deploy.
  // Feature flags stay at their defaults (all off) for the lessons-only deploy.
  "vars": {
    "APP_URL": "https://sv-uvm-guide.rakesh-n99.workers.dev",
    "NEXTAUTH_URL": "https://sv-uvm-guide.rakesh-n99.workers.dev"
  },
  // Per-branch Previews (Workers Builds runs `npx wrangler preview` on non-main branches). Vars are not inherited
  // from the top level. They keep the production origin, so canonical links and the sitemap point at the live site.
  "previews": {
    "vars": {
      "APP_URL": "https://sv-uvm-guide.rakesh-n99.workers.dev",
      "NEXTAUTH_URL": "https://sv-uvm-guide.rakesh-n99.workers.dev"
    }
  }
}
