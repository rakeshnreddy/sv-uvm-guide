// =============================================================
// Lab Solution: Memory Read/Write Portable Intent
// File: solution/mem_test.pss
// =============================================================

typedef bit[32] addr_t;
typedef bit[32] data_t;

// The write hands its address and data to the read through a buffer:
// the producer (write_mem) completes before the consumer (read_verify) starts.
buffer mem_buf_s {
  rand addr_t addr;
  rand data_t data;

  // A simple memory target with a 4 KB legal address window.
  constraint legal_window { addr in [0x1000..0x1FFF]; }
}

component mem_portability_lab {
  pool mem_buf_s buf_p;   // where mem_buf_s objects are exchanged
  bind buf_p *;

  action write_mem {
    output mem_buf_s wr;  // the buffer this write produces

    // An action may constrain the fields of its own flow objects.
    constraint legal_write {
      wr.addr % 4 == 0;
      wr.data in [0x0000..0xFFFF];
    }

    // Wrapped in begin/end so the declaration is legal wherever the
    // generator pastes this block inside a task body.
    exec body SV = """
      begin
        mem_write_seq wr_seq = mem_write_seq::type_id::create("wr_seq");
        wr_seq.addr = {{wr.addr}};
        wr_seq.data = {{wr.data}};
        wr_seq.start(p_sequencer.mem_sqr);
      end
    """;

    exec body C = """
      mem_write32({{wr.addr}}, {{wr.data}});
    """;
  }

  action read_verify {
    input mem_buf_s rd;   // the buffer some write_mem produced

    exec body SV = """
      begin
        mem_read_seq rd_seq = mem_read_seq::type_id::create("rd_seq");
        rd_seq.addr = {{rd.addr}};
        rd_seq.start(p_sequencer.mem_sqr);
        if (rd_seq.data !== {{rd.data}})
          `uvm_error("PSS_MEM_VERIFY",
            $sformatf("addr=0x%08x expected=0x%08x actual=0x%08x",
                      {{rd.addr}}, {{rd.data}}, rd_seq.data))
      end
    """;

    exec body C = """
      if (mem_read32({{rd.addr}}) != {{rd.data}})
          test_fail("read-after-write mismatch");
    """;
  }

  action mem_read_write_test {
    activity {
      wr_a: do write_mem;
      rd_a: do read_verify;
      bind wr_a.wr rd_a.rd;  // read exactly the buffer this write produced
    }
  }
}
