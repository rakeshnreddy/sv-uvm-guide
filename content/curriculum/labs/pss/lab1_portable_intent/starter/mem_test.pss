// =============================================================
// Lab: Memory Read/Write Portable Intent
// File: starter/mem_test.pss (complete the TODOs)
//
// Three parts: the scenario (no target code), then one realization
// package per target language. Each generated test uses ONE package:
// mem_real_sv for the UVM test, mem_real_c for the C test.
// =============================================================

typedef bit[32] addr_t;
typedef bit[32] data_t;

// ---- Part 1: the scenario, the same for every target ----

// The write hands its address and data to the read through a buffer:
// the producer (write_mem) completes before the consumer (read_verify) starts.
buffer mem_buf_s {
  rand addr_t addr;
  rand data_t data;

  // A simple memory target with a 4 KB legal address window.
  constraint legal_window { addr in [0x1000..0x1FFF]; }
}

// Root component: tell the tool to use mem_portability_lab (the default root
// component name is pss_top) and mem_read_write_test as the root action.
component mem_portability_lab {
  pool mem_buf_s buf_p;   // where mem_buf_s objects are exchanged
  bind buf_p *;

  // Atomic actions: their exec body templates go in the packages below.
  action write_mem {
    output mem_buf_s wr;  // the buffer this write produces

    constraint legal_write {
      // TODO 1: constrain wr.addr to a 4-byte aligned value.

      // TODO 2: constrain wr.data to the range 0x0000 through 0xFFFF.
    }
  }

  action read_verify {
    // TODO 3: declare an input of type mem_buf_s named rd
    //         (the buffer some write_mem produced).
  }

  action mem_read_write_test {
    activity {
      // TODO 4: traverse write_mem with the label wr_a.
      // TODO 5: traverse read_verify with the label rd_a, after wr_a.
      // TODO 6: bind wr_a.wr to rd_a.rd so the read checks this write's buffer.
    }
  }
}

// ---- Why two packages ----
// A single exec block maps to at most one language, and same-kind exec
// blocks in one scope merge into one block (PSS 3.0 §22.1.1 b, e). The
// standard gives one action a C and an SV realization through different
// packages that are not used for the same test (§22.5.1). How you tell the
// tool which package is active is tool-dependent (§21.1).

// ---- Part 2: SystemVerilog realization (UVM test) ----
package mem_real_sv {
  extend action mem_portability_lab::write_mem {
    // Templates are pasted verbatim: wrap the SV in begin ... end.
    exec body SV = """
      // TODO: inside begin ... end, create a mem_write_seq, set its addr and data
      //       from {{wr.addr}} and {{wr.data}}, and start it on p_sequencer.mem_sqr.
    """;
  }

  extend action mem_portability_lab::read_verify {
    exec body SV = """
      // TODO: inside begin ... end, start a mem_read_seq on {{rd.addr}} and
      //       report PSS_MEM_VERIFY with `uvm_error if its data differs from {{rd.data}}.
    """;
  }
}

// ---- Part 3: C realization (bare-metal test) ----
package mem_real_c {
  extend action mem_portability_lab::write_mem {
    exec body C = """
      // TODO: call mem_write32() with {{wr.addr}} and {{wr.data}}.
    """;
  }

  extend action mem_portability_lab::read_verify {
    exec body C = """
      // TODO: read {{rd.addr}} and call test_fail() if it differs from {{rd.data}}.
    """;
  }
}
